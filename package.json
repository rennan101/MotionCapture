{
  "name": "motion-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm -C apps/web dev",
    "dev:web:standalone": "cd apps/web && /opt/homebrew/bin/node node_modules/vite/bin/vite.js --port 5173",
    "dev:desktop": "pnpm -C apps/desktop dev",
    "build:web": "pnpm -C apps/web build",
    "build:desktop": "pnpm -C apps/desktop build",
    "build": "pnpm -r build"
  },
  "packageManager": "pnpm@12.3.4",
  "pnpm": {
    "allowBuilds": {
      "esbuild": true
    }
  }
}
